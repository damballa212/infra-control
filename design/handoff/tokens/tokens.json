{
  "$description": "Única fuente de verdad del diseño (variante D · Pixel atardecer). tokens.css y tokens.ts se generan con `npm run tokens`; no se editan a mano. Los valores con {ruta} son referencias a otro token.",
  "$version": "1.0.0",
  "color": {
    "brand": {
      "night": "#1B1A3A",
      "dusk": "#2E2C5E",
      "violet": "#5B3F8C",
      "violetSoft": "#8C7AB8",
      "coral": "#FF7A6B",
      "coralDeep": "#C24F43",
      "orange": "#FF9F43",
      "orangeDeep": "#B39A1E",
      "sun": "#FFD166",
      "cream": "#FFF4E0",
      "paper": "#FFFBF3",
      "dots": "#F3DFC0",
      "sand": "#E8CFA8",
      "sandLine": "#EAD7BA",
      "rose": "#F7A8B8",
      "mint": "#7FD8BE",
      "ink": "#0E0D22",
      "white": "#FFFFFF",
      "hover": "#FBE6C8"
    },
    "text": {
      "default": "{color.brand.night}",
      "muted": "#5A4A6A",
      "accent": "{color.brand.violet}",
      "onNight": "{color.brand.cream}",
      "mutedOnNight": "#D9CBE8",
      "accentOnNight": "{color.brand.sun}",
      "onDanger": "{color.brand.white}"
    },
    "surface": {
      "page": "{color.brand.cream}",
      "paper": "{color.brand.paper}",
      "night": "{color.brand.night}",
      "nightRaised": "{color.brand.dusk}",
      "sun": "{color.brand.sun}",
      "hover": "{color.brand.hover}",
      "disabled": "#EDE3D3",
      "scrim": "rgba(27, 26, 58, 0.62)"
    },
    "state": {
      "okBg": "#DDFBE8",
      "okGlyph": "#0E7A43",
      "busyBg": "#EFE4FF",
      "busyBorder": "{color.brand.violet}",
      "warnBg": "{color.brand.sun}",
      "noneBg": "#F4EBDD",
      "noneBorder": "{color.text.muted}",
      "dangerBg": "#C8102E",
      "dangerDeep": "#7A0A1C",
      "dangerText": "#C8102E",
      "dangerOnNight": "#FF8A80"
    },
    "focus": {
      "ring": "{color.brand.night}",
      "ringOnNight": "{color.brand.sun}",
      "ringOnPaper": "{color.brand.violet}"
    },
    "sprite": {
      "K": "{color.brand.ink}",
      "N": "{color.brand.dusk}",
      "V": "{color.brand.violet}",
      "R": "{color.brand.coral}",
      "O": "{color.brand.orange}",
      "Y": "{color.brand.sun}",
      "W": "{color.brand.cream}",
      "P": "{color.brand.rose}",
      "B": "{color.brand.rose}",
      "M": "{color.brand.mint}",
      "C": "{color.brand.sand}",
      "S": "{color.brand.white}"
    }
  },
  "font": {
    "family": {
      "display": "'Pixelify Sans', ui-monospace, monospace",
      "body": "'Work Sans', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "size": {
      "note": "12px",
      "caption": "13px",
      "small": "14px",
      "body": "15px",
      "bodyLg": "16px",
      "key": "17px",
      "keyLg": "18px",
      "h3": "20px",
      "h2": "28px",
      "h2Lg": "30px",
      "title": "34px",
      "h1": "46px",
      "hero": "52px",
      "heroLg": "56px"
    },
    "lineHeight": {
      "tight": "1",
      "snug": "1.15",
      "body": "1.45",
      "caption": "1.35"
    }
  },
  "space": {
    "2": "2px",
    "4": "4px",
    "6": "6px",
    "8": "8px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "16": "16px",
    "18": "18px",
    "20": "20px",
    "22": "22px",
    "24": "24px",
    "26": "26px",
    "28": "28px",
    "30": "30px",
    "34": "34px",
    "36": "36px",
    "38": "38px",
    "40": "40px",
    "52": "52px",
    "54": "54px"
  },
  "size": {
    "hitbox": "48px",
    "key": "52px",
    "keyLg": "56px",
    "pill": "30px",
    "chip": "38px",
    "tabbar": "84px",
    "sidenav": "232px",
    "sidenavCompact": "108px",
    "headerScene": "192px",
    "headerSceneDesktop": "200px"
  },
  "radius": {
    "none": "0",
    "round": "50%"
  },
  "border": {
    "thin": "2px",
    "regular": "3px",
    "pixel": "4px",
    "dashed": "dashed"
  },
  "elevation": {
    "pixel": "0 -4px 0 0 {color.brand.night}, 0 4px 0 0 {color.brand.night}, -4px 0 0 0 {color.brand.night}, 4px 0 0 0 {color.brand.night}",
    "pixelCream": "0 -4px 0 0 {color.brand.cream}, 0 4px 0 0 {color.brand.cream}, -4px 0 0 0 {color.brand.cream}, 4px 0 0 0 {color.brand.cream}",
    "pixelThin": "0 -3px 0 0 {color.brand.night}, 0 3px 0 0 {color.brand.night}, -3px 0 0 0 {color.brand.night}, 3px 0 0 0 {color.brand.night}",
    "pixelDanger": "0 -4px 0 0 {color.state.dangerBg}, 0 4px 0 0 {color.state.dangerBg}, -4px 0 0 0 {color.state.dangerBg}, 4px 0 0 0 {color.state.dangerBg}",
    "base": "0 10px 0 0",
    "baseKey": "0 8px 0 0",
    "dialog": "0 -8px 0 0 {color.brand.night}, 0 8px 0 0 {color.brand.night}, -8px 0 0 0 {color.brand.night}, 8px 0 0 0 {color.brand.night}",
    "insetCream": "inset 0 0 0 3px {color.brand.cream}"
  },
  "breakpoint": {
    "compact": 700,
    "medium": 1100,
    "$note": "Valores en px para @media; CSS no admite var() ahí. Los tests verifican que styles/*.css use estos mismos números."
  },
  "motion": {
    "duration": {
      "press": "80ms",
      "enter": "420ms",
      "wipe": "300ms",
      "type": "520ms",
      "dialog": "180ms",
      "burst": "760ms",
      "scene": "24s"
    },
    "easing": {
      "pixelPress": "steps(2, end)",
      "pixelEnter": "steps(6, end)",
      "pixelWipe": "steps(8, end)",
      "pixelType": "steps(24, end)",
      "smooth": "ease-in-out"
    },
    "$note": "Con prefers-reduced-motion: reduce toda animación y transición se anula (styles/animations.css)."
  }
}
