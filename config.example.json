{
  "origin": "https://panel.example.com",
  "passwordHash": "<output of scripts/make-credentials.ts>",
  "agentTokens": [
    {
      "name": "rakazo-read",
      "hash": "<sha256 of a unique token stored in Rakazo's secret store>",
      "scopes": ["read"],
      "mcpTools": ["list_resources", "get_resource", "list_projects", "get_incidents", "get_cost_summary", "get_operation"],
      "readPolicy": { "accountIds": ["123456789012"], "costs": true }
    },
    {
      "name": "rakazo-operator",
      "hash": "<a different sha256 token; do not reuse the reader token>",
      "scopes": ["read", "operate"],
      "mcpTools": ["list_resources", "get_resource", "plan_operation", "execute_operation", "get_operation"],
      "readPolicy": { "resourceIds": ["aws:prod:i-0123456789abcdef0"] },
      "operationPolicy": { "actions": ["stop"], "resourceIds": ["aws:prod:i-0123456789abcdef0"] }
    }
  ],
  "aws": [
    {
      "name": "prod",
      "accountId": "123456789012",
      "accessKeyId": "<IAM user with start/stop/describe on the listed instances only>",
      "secretAccessKey": "<secret>",
      "instances": [
        { "id": "i-0123456789abcdef0", "region": "us-east-1", "name": "web-1", "type": "t3.small" }
      ]
    }
  ],
  "coolify": { "url": "", "token": "", "resources": [] },
  "acs": { "url": "", "deviceId": "" },
  "desktop": {
    "socketPath": "/run/infra-control-wol/wol.sock",
    "reportTokenHashes": { "windows": "<sha256>", "cachyos": "<sha256>" }
  },
  "routerTelemetryTokenHash": "<sha256>",
  "macTelemetryTokenHash": "<sha256>",
  "hermes": { "resourceId": "aws:prod:i-0123456789abcdef0", "reportTokenHash": "<sha256>" },
  "otelCollectors": [],
  "serviceProbes": [],
  "push": {
    "vapidPublicKey": "",
    "vapidPrivateKey": "",
