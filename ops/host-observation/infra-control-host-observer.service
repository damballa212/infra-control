[Unit]
Description=Infra Control local host observation
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/infra-control-host-observer/collector.py
StateDirectory=infra-control-host-observer
StateDirectoryMode=0750
UMask=0027
TimeoutStartSec=25s
RuntimeMaxSec=25s
MemoryMax=128M
TasksMax=64
CPUQuota=25%
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ReadOnlyPaths=/proc /sys /etc
ReadWritePaths=/var/lib/infra-control-host-observer
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
StandardOutput=null
StandardError=journal
