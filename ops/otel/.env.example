# Provide a unique host ID that matches the corresponding otelCollectors entry.
INFRA_CONTROL_HOST_ID=host-replace-me
# Include the full HTTPS endpoint, including /api/telemetry/otlp/v1/metrics.
INFRA_CONTROL_OTLP_URL=https://panel.example.com/api/telemetry/otlp/v1/metrics
# Generate one random token per host; store only its SHA-256 in panel config.
INFRA_CONTROL_OTLP_TOKEN=replace-with-a-long-random-secret
