[Unit]
Description=Private Infra Control WOL broker
After=network-online.target ssh.service
Before=docker.service
Wants=network-online.target

[Service]
Type=simple
User=infra-wol
Group=1000
ExecStart=/opt/infra-control/current/runtime/node --preserve-symlinks-main /opt/infra-control/current/dist/server/wol-broker.js
Restart=on-failure
RestartSec=5
RuntimeDirectory=infra-control-wol
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes

[Install]
WantedBy=multi-user.target
