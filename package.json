{
  "name": "infra-control",
  "version": "0.16.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc --noEmit",
    "contract": "tsx scripts/export-contract.ts",
    "lint": "oxlint server contracts scripts tests",
    "format:check": "prettier --check \"{server,contracts,scripts,tests}/**/*.ts\"",
    "format": "prettier --write \"{server,contracts,scripts,tests}/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.1175.0",
    "@aws-sdk/client-cost-explorer": "^3.1175.0",
    "@aws-sdk/client-ec2": "^3.1175.0",
    "@aws-sdk/client-sts": "3.1175.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "author": "damballa212"
}
